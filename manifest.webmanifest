{
  "name": "SPECTRA",
  "short_name": "SPECTRA",
  "description": "Audio-reactive generative visuals for live sets.",
  "start_url": "./VJ%20Fractal.dc.html",
  "scope": "./",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://jookem.github.io/spectra/manifest.webmanifest"
    }
  ],
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "landscape",
  "background_color": "#08090A",
  "theme_color": "#08090A",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}